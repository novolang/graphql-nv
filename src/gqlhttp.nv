// gqlhttp.nv — the shape a `web` row mounts: a request read out of a
// body or a query, and a response written back.  `[]`.
//
// NOTHING HERE PERFORMS ANYTHING, and that is the whole reason it is a
// separate module.  A GraphQL transport is a small amount of parsing
// and a large amount of POLICY — which method, which media type, which
// status — and every one of those decisions is a value a test can
// assert.  The socket belongs to the caller's server; this module
// turns bytes into a `GqlRequest` and a `GqlResponse` into bytes.
//
// THE STATUS CODE IS THE PART THE GRAPHQL OVER HTTP SPECIFICATION
// EXISTS TO SETTLE, and the answer is not what a reader expects.
//
//   · A response carrying `errors` is a **200**, as long as execution
//     began.  The query ran, some fields failed, the body says which —
//     and a client library that retried on 5xx would, against a server
//     that answered 500 for a failed resolver, retry every partial
//     success forever.
//   · A request that never became an execution — a syntax error, a
//     validation failure, a bad variable — is a 200 under the LEGACY
//     media type `application/json`, and a **400** under
//     `application/graphql-response+json`.
//
// That second line is the whole of the specification's compatibility
// story: the status depends on what the client ASKED FOR, because
// existing clients were written against servers that answered 200 for
// everything and changing it under them would break them.
// `status_for` takes the negotiated media type for exactly this
// reason, and `negotiate` is what picks it.
//
// GET IS FOR QUERIES ONLY, AND THAT IS NOT PEDANTRY.  A mutation over
// GET is a mutation a browser will prefetch, a proxy will cache and a
// crawler will follow — `<img src="/graphql?query=mutation{deleteAll}">`
// on any page anywhere.  `read_get` refuses a mutation with a 405 and
// an `Allow: POST`, which is the answer that tells the client what to
// do instead.

use std.json
use std.list
use std.str
use formurl
use gqlerr
use gqlexec
use gqllang

// The body ceiling the conventional policy sets: one mebibyte, which
// is past any document a client writes by hand and short of the body
// that ends a server.
const MAX_BODY_BYTES = 1048576

// What a deployment allows over HTTP.
pub struct GqlHttpPolicy
    // Whether GET is accepted at all.  True: a GET query is
    // cacheable, which is the whole reason the specification kept it.
    allow_get: Bool
    // Whether a mutation over GET is accepted.  FALSE, and it stays
    // false: a mutation a browser can prefetch is a mutation a crawler
    // will perform.
    allow_get_mutation: Bool
    // The largest request body, in bytes.
    max_body_bytes: Int
    // Whether `extensions` in the request is read.  True; a persisted
    // query identifier arrives there.
    read_extensions: Bool

// The conventional policy.
//
// ```novo
// use gqlhttp
//
// fn main() [io]
//     println("${gqlhttp.defaults().allow_get_mutation}")
// ```
pub fn defaults() -> GqlHttpPolicy []
    GqlHttpPolicy { allow_get: true, allow_get_mutation: false,
                    max_body_bytes: MAX_BODY_BYTES, read_extensions: true }

// The same, refusing GET entirely.
//
// For a deployment behind a cache it does not want GraphQL responses
// in.
//
// ```novo
// use gqlhttp
//
// fn main() [io]
//     println("${gqlhttp.post_only().allow_get}")
// ```
pub fn post_only() -> GqlHttpPolicy []
    GqlHttpPolicy { allow_get: false, allow_get_mutation: false,
                    max_body_bytes: MAX_BODY_BYTES, read_extensions: true }

// ── Reading a request ────────────────────────────────────────────────

// Whether a member is present and is a string.
//
// A member that is present and is NOT a string is refused rather than
// read as absent: a client that sent `"operationName": 3` sent
// something, and quietly answering the only operation in the document
// is an answer to a different question.
fn member_is_string(v: json.JsonValueH, key: Str) -> Bool []
    match json.get(v, key)
        None    => true
        Some(m) => json.type_of(m) == "string"

// Whether a member is present and is an object.
fn member_is_object(v: json.JsonValueH, key: Str) -> Bool []
    match json.get(v, key)
        None    => true
        Some(m) => json.type_of(m) == "object"

// A member as text, or empty where it is absent.
fn member_text(v: json.JsonValueH, key: Str) -> Str []
    json.get_str(v, key) ?? ""

// A member that is an object, as JSON text.
//
// The executor is handed TEXT rather than a value, so a member that
// arrived parsed is written back out — and `json.stringify` preserves
// the order the client wrote, which is the order a resolver reading
// the variables will see.
fn member_object_text(v: json.JsonValueH, key: Str) -> Str []
    match json.get(v, key)
        None    => ""
        Some(m) => json.stringify(m)

// The `extensions` member, where the policy reads it at all.
fn extensions_member(v: json.JsonValueH, p: GqlHttpPolicy) -> Str []
    if p.read_extensions
        member_object_text(v, "extensions")
    else
        ""

// A POST body's JSON object as a request.
fn object_request(v: json.JsonValueH,
                  p: GqlHttpPolicy) -> Result<gqlexec.GqlRequest, gqlerr.GqlFault> []
    if not member_is_string(v, "query")
        Err(gqlerr.GqlRequestMalformed("`query` is not a string"))
    elif str.len(member_text(v, "query")) == 0
        Err(gqlerr.GqlRequestMalformed("the request has no `query` member"))
    elif not member_is_string(v, "operationName")
        Err(gqlerr.GqlRequestMalformed("`operationName` is not a string"))
    elif not member_is_object(v, "variables")
        Err(gqlerr.GqlRequestMalformed("`variables` is not a JSON object"))
    elif p.read_extensions and not member_is_object(v, "extensions")
        Err(gqlerr.GqlRequestMalformed("`extensions` is not a JSON object"))
    else
        Ok(GqlRequest { query: member_text(v, "query"),
                        operation_name: member_text(v, "operationName"),
                        variables: member_object_text(v, "variables"),
                        extensions: extensions_member(v, p) })

// A parameter's value, or empty where the parameter is absent.
fn param(b: formurl.FormBody, key: Str) -> Str []
    match formurl.get(b, key)
        Some(v) => v
        None    => ""

// Whether a parameter arrives more than once.
//
// form-nv SEES every occurrence; `http.server.query_get` would answer
// the first and drop the rest, and a request whose meaning depends on
// which of two `query` parameters a server picked is a request no
// client sent.
fn repeated(b: formurl.FormBody, key: Str) -> Bool []
    formurl.count(b, key) > 1

// A JSON object carried inside a parameter, as text.
//
// Empty is the absent case and is not an error, because both members
// it is used for are optional.
fn object_param(text: Str, name: Str) -> Result<Str, gqlerr.GqlFault> []
    if str.len(text) == 0
        Ok("")
    else
        match json.parse(text)
            None    => Err(gqlerr.GqlRequestMalformed("`" + name + "` is not JSON"))
            Some(v) => object_text_of(v, name)

// A parsed parameter that has to be an object.
fn object_text_of(v: json.JsonValueH, name: Str) -> Result<Str, gqlerr.GqlFault> []
    if json.type_of(v) == "object"
        Ok(json.stringify(v))
    else
        Err(gqlerr.GqlRequestMalformed("`" + name + "` is not a JSON object"))

// The `extensions` parameter of a form body, where the policy reads it.
fn extensions_param(b: formurl.FormBody, p: GqlHttpPolicy) -> Result<Str, gqlerr.GqlFault> []
    if p.read_extensions
        object_param(param(b, "extensions"), "extensions")
    else
        Ok("")

// A POST body read into a request.
//
// The body is JSON with `query`, and optionally `operationName`,
// `variables` and `extensions`.  Refuses a body that is not a JSON
// object, one with no `query`, and one whose `variables` is not an
// object — each named, because "bad request" about a forty-line body
// is not something a developer can act on.
//
// ```novo
// use gqlhttp
//
// fn main() [io]
//     match gqlhttp.read_post("{\"query\":\"{ me }\"}", gqlhttp.defaults())
//         Ok(r)  => println(r.query)
//         Err(_) => println("not a GraphQL request")
// ```
pub fn read_post(body: Str, p: GqlHttpPolicy) -> Result<gqlexec.GqlRequest, gqlerr.GqlFault> []
    if str.len(body) > p.max_body_bytes
        Err(gqlerr.GqlTooLarge("request body", str.len(body), p.max_body_bytes))
    else
        match json.parse(body)
            None    => Err(gqlerr.GqlRequestMalformed("the body is not JSON"))
            Some(v) => object_body(v, p)

// A parsed POST body that has to be an object.
fn object_body(v: json.JsonValueH,
               p: GqlHttpPolicy) -> Result<gqlexec.GqlRequest, gqlerr.GqlFault> []
    if json.type_of(v) == "object"
        object_request(v, p)
    else
        Err(gqlerr.GqlRequestMalformed("the body is JSON and is not an object"))

// A GET query string read into a request.
//
// `query`, `operationName`, `variables` and `extensions` as query
// parameters, with the last two being JSON text inside them.
//
// Reads with form-nv, which SEES a repeated parameter: a request
// carrying two `query` values is refused rather than half-read, where
// `http.server.query_get` would answer the first and drop the rest.
//
// Does NOT refuse a mutation — the document has not been parsed yet.
// `refuses_get_mutation` is that check, run after the parse.
//
// ```novo
// use gqlhttp
//
// fn main() [io]
//     match gqlhttp.read_get("query=%7B%20me%20%7D", gqlhttp.defaults())
//         Ok(r)  => println(r.query)
//         Err(_) => println("not a GraphQL request")
// ```
pub fn read_get(query_string: Str,
                p: GqlHttpPolicy) -> Result<gqlexec.GqlRequest, gqlerr.GqlFault> []
    read_form(formurl.parse_str(query_string), p)

// The same, from a form body already parsed.
//
// For the caller that parsed the query for another reason.
//
// ```novo
// use formurl
// use gqlhttp
//
// fn main() [io]
//     match gqlhttp.read_form(formurl.parse_str("query=%7Bme%7D"), gqlhttp.defaults())
//         Ok(r)  => println(r.query)
//         Err(_) => println("not a GraphQL request")
// ```
pub fn read_form(b: formurl.FormBody,
                 p: GqlHttpPolicy) -> Result<gqlexec.GqlRequest, gqlerr.GqlFault> []
    if not p.allow_get
        Err(gqlerr.GqlRequestMalformed("this deployment answers GET with a 405 and `Allow: POST`"))
    elif repeated(b, "query")
        Err(gqlerr.GqlRequestMalformed("the `query` parameter appears more than once"))
    elif repeated(b, "variables")
        Err(gqlerr.GqlRequestMalformed("the `variables` parameter appears more than once"))
    elif repeated(b, "extensions")
        Err(gqlerr.GqlRequestMalformed("the `extensions` parameter appears more than once"))
    elif not formurl.has(b, "query")
        Err(gqlerr.GqlRequestMalformed("the request has no `query` parameter"))
    else
        let vars = object_param(param(b, "variables"), "variables")!
        if_extensions(b, p, vars)

// A form body whose variables are read, onto its extensions.
fn if_extensions(b: formurl.FormBody, p: GqlHttpPolicy,
                 vars: Str) -> Result<gqlexec.GqlRequest, gqlerr.GqlFault> []
    let ext = extensions_param(b, p)!
    Ok(GqlRequest { query: param(b, "query"),
                            operation_name: param(b, "operationName"),
                            variables: vars,
                            extensions: ext })

// Whether a document's operation is a write.
fn is_mutation(kind: gqllang.GqlOpKind) -> Bool []
    match kind
        GqlMutation     => true
        GqlQuery        => false
        GqlSubscription => false

// Whether a GET must be refused because its document mutates.
//
// Run AFTER the parse, because that is when the operation's kind is
// known.  `true` means answer a 405 with `Allow: POST` — which tells
// the client what to do, where a 400 would only tell it that something
// was wrong.
//
// A mutation over GET is a mutation a browser will prefetch, a proxy
// will cache and a crawler will follow.
//
// ```novo
// use gqlhttp
// use gqllang
//
// fn main() [io]
//     println("${gqlhttp.refuses_get_mutation(gqlhttp.defaults(), gqllang.GqlMutation)}")
// ```
pub fn refuses_get_mutation(p: GqlHttpPolicy, kind: gqllang.GqlOpKind) -> Bool []
    is_mutation(kind) and not p.allow_get_mutation

// The `Allow` header for a refused GET: `POST`.
//
// ```novo
// use gqlhttp
//
// fn main() [io]
//     println(gqlhttp.allow_header())
// ```
pub fn allow_header() -> Str []
    "POST"

// A media type with its case, its whitespace and its parameters
// removed: `Application/JSON; charset=utf-8` is `application/json`.
//
// § 3.1's header is case-insensitive, and a parameter is a fact about
// the bytes that follow the type rather than part of the type.
fn bare_media_type(value: Str) -> Str []
    let lower = str.lower(str.trim(value))
    match str.index(lower, ";")
        None    => lower
        Some(i) => str.trim(str.slice(lower, 0, i))

// Whether a request's `Content-Type` is one this transport reads.
//
// `application/json` alone.  `application/graphql` was a proposal that
// was never ratified and `application/x-www-form-urlencoded` is a
// shape a CSRF form can produce — which is why a GraphQL endpoint that
// accepts it has a cross-site request forgery on every mutation, and
// why this answers false for it.
//
// ```novo
// use gqlhttp
//
// fn main() [io]
//     println("${gqlhttp.reads_content_type("application/json; charset=utf-8")}")
// ```
pub fn reads_content_type(content_type: Str) -> Bool []
    bare_media_type(content_type) == "application/json"

// ── Writing a response ───────────────────────────────────────────────

// The media type the specification added, and the one under which a
// request error is a 400.
fn modern_media() -> Str []
    "application/graphql-response+json"

// The media type every GraphQL server answered before the
// specification, and the one a client that asked for nothing gets.
fn legacy_media() -> Str []
    "application/json"

// Whether a negotiated media type is the modern one.
fn is_modern(media_type: Str) -> Bool []
    bare_media_type(media_type) == modern_media()

// The media type a request's `Accept` header negotiates to.
//
// `application/graphql-response+json` where the client asked for it,
// `application/json` otherwise — which is the specification's own
// default and the legacy behaviour.  The choice decides the STATUS
// CODE, which is why it is a function rather than a constant.
//
// ```novo
// use gqlhttp
//
// fn main() [io]
//     println(gqlhttp.negotiate("application/graphql-response+json"))
// ```
pub fn negotiate(accept: Str) -> Str []
    if str.contains(str.lower(accept), modern_media())
        modern_media()
    else
        legacy_media()

// The status a response gets, given the negotiated media type.
//
// The whole table:
//
//   · execution began, with or without errors → **200**, always;
//   · a request error under `application/json` → **200**, because
//     that is what clients written against the legacy behaviour
//     expect;
//   · a request error under `application/graphql-response+json` →
//     **400**;
//   · a variable coercion failure → the same two, by media type.
//
// A client library that retried on 5xx would, against a server that
// answered 500 for a failed resolver, retry every partial success
// forever.  That is the mistake this function exists to prevent, and
// it is one somebody makes in every GraphQL server written by hand.
//
// ```novo
// use gqlhttp
// use gqlexec
//
// fn main() [io]
//     let r = gqlexec.empty_response()
//     println("${gqlhttp.status_for(r, "application/json")}")
// ```
pub fn status_for(r: gqlexec.GqlResponse, media_type: Str) -> Int []
    // A response with no `data` member at all is a request that never
    // executed, and only errors in it make it the client's fault.  A
    // response with NEITHER — the shape a probe answers — executed
    // nothing and failed at nothing, and a 400 for it would be a
    // refusal invented out of an empty body.
    if gqlexec.has_data(r)
        200
    elif list.len(r.errors) > 0 and is_modern(media_type)
        400
    else
        200

// The status for a request that never became an execution.
//
// Separate from `status_for` because there is no response to look at
// — the fault IS the answer.
//
// ```novo
// use gqlerr
// use gqlhttp
//
// fn main() [io]
//     let f = gqlerr.GqlSyntaxError("unexpected `}`", 1, 12)
//     println("${gqlhttp.status_for_fault(f, "application/graphql-response+json")}")
// ```
pub fn status_for_fault(f: gqlerr.GqlFault, media_type: Str) -> Int []
    // A schema fault is the deployment's and not the client's: every
    // request against it fails identically until somebody fixes it,
    // and a 400 tells the client to fix its document.  `gqlerr` keeps
    // the distinction for this caller.
    if gqlerr.is_configuration_fault(f)
        500
    elif is_modern(media_type)
        400
    else
        200

// The `Content-Type` header for a response in a media type.
//
// With `charset=utf-8`, which § 6.1 of the GraphQL over HTTP
// specification requires and which a client that guessed would guess
// right only until somebody's name has an accent in it.
//
// ```novo
// use gqlhttp
//
// fn main() [io]
//     println(gqlhttp.content_type("application/json"))
// ```
pub fn content_type(media_type: Str) -> Str []
    media_type + "; charset=utf-8"

// The headers a response carries, in order.
//
// `Content-Type`, and nothing else: a GraphQL response has one header,
// and the `Allow` a refused GET answers belongs to the 405 the CALLER
// answered — a `GqlResponse` does not know which method asked for it,
// and `allow_header` is the value that caller attaches.
//
// Published as a list so a caller attaches them without deciding which.
//
// ```novo
// use std.list
// use gqlexec
// use gqlhttp
//
// fn main() [io]
//     let r = gqlexec.empty_response()
//     println("${list.len(gqlhttp.response_headers(r, "application/json"))}")
// ```
pub fn response_headers(r: gqlexec.GqlResponse, media_type: Str) -> [(Str, Str)] []
    [("Content-Type", content_type(media_type))]

// A fault as a response body, in the media type negotiated.
//
// The two media types differ in more than their status code: under
// `application/graphql-response+json` a request error's body carries
// `errors` and no `data` member, and under `application/json` it
// carries `"data": null` as well — which is what the clients written
// against the legacy behaviour were read by, and one more reason the
// status is not the only thing the negotiation decides.
//
// ```novo
// use gqlerr
// use gqlhttp
//
// fn main() [io]
//     let f = gqlerr.GqlSyntaxError("unexpected `}`", 1, 12)
//     println(gqlhttp.fault_body(f, "application/json"))
// ```
pub fn fault_body(f: gqlerr.GqlFault, media_type: Str) -> Str []
    if is_modern(media_type)
        gqlexec.response_json(gqlexec.error_response(gqlerr.errors_of(f)))
    else
        gqlexec.response_json(GqlResponse { data: "null",
                                            errors: gqlerr.errors_of(f),
                                            extensions: "" })

// ── Cross-site request forgery ───────────────────────────────────────

// Whether one named header is the thing its entry in the published
// list is about.
//
// `Content-Type` counts when it is JSON, because a form can only send
// three content types and none of them is JSON; the others count when
// they are there at all, because a request carrying a header of its
// own has been through a CORS preflight.
fn reads_a_preflight(name: Str, value: Str) -> Bool []
    if name == "Content-Type"
        reads_content_type(value)
    else
        str.len(value) > 0

// The names, in the order a person reads them.
fn preflight_header_names() -> [Str] []
    ["Content-Type", "X-Apollo-Operation-Name", "Apollo-Require-Preflight"]

// Whether a request's headers show it was sent by a program rather
// than by a form a page on another site submitted.
//
// The check the GraphQL over HTTP specification recommends and does
// not require: a request carrying a `Content-Type: application/json`,
// or a non-empty `X-Apollo-Operation-Name` or `Apollo-Require-Preflight`
// header, cannot have come from a plain HTML form — because a form can
// only send three content types and none of them is JSON, and a
// request carrying a custom header has been through a CORS preflight.
//
// Published because a GraphQL endpoint that accepts
// `application/x-www-form-urlencoded` has a cross-site request forgery
// on every mutation, and because the reasoning is not obvious enough
// to leave to each deployment.
//
// ```novo
// use gqlhttp
//
// fn no_headers(name: Str) -> Str
//     ""
//
// fn main() [io]
//     println("${gqlhttp.looks_preflighted(no_headers)}")
// ```
pub fn looks_preflighted(header: fn(Str) -> Str []) -> Bool []
    var preflighted: Bool = false
    for name in preflight_header_names()
        if reads_a_preflight(name, header(name))
            preflighted = true
    preflighted

// The headers whose presence `looks_preflighted` accepts, as strings a
// person can read.
//
// The list IS the contract: a deployment adding its own client header
// to it is making a decision, and one reading the list can see what is
// being trusted.
//
// ```novo
// use std.list
// use gqlhttp
//
// fn main() [io]
//     println("${list.len(gqlhttp.preflight_headers())}")
// ```
pub fn preflight_headers() -> [Str] []
    preflight_header_names()

// ── Persisted queries ────────────────────────────────────────────────

// The hash out of Apollo's `persistedQuery` object.
fn hash_member(v: json.JsonValueH) -> Str []
    match json.get(v, "persistedQuery")
        None     => ""
        Some(pq) => json.get_str(pq, "sha256Hash") ?? ""

// The persisted-query hash a request's `extensions` carries, or empty.
//
// Apollo's automatic persisted queries put
// `{"persistedQuery":{"version":1,"sha256Hash":"…"}}` there, and a
// deployment that supports them looks the hash up rather than parsing
// a document.  Reading the field is four lines nobody should write
// twice; STORING the documents is a deployment's own business and this
// package holds no table.
//
// ```novo
// use gqlexec
// use gqlhttp
//
// fn main() [io]
//     println(gqlhttp.persisted_hash(gqlexec.request("{ me }")))
// ```
pub fn persisted_hash(req: gqlexec.GqlRequest) -> Str []
    if str.len(req.extensions) == 0
        ""
    else
        match json.parse(req.extensions)
            None    => ""
            Some(v) => hash_member(v)

// The error a server answers for a persisted query it does not know.
//
// `PERSISTED_QUERY_NOT_FOUND` in `extensions.code`, which is the
// convention every client implementing the protocol retries on — by
// sending the document.  A deployment that answered anything else gets
// a client that gives up instead.
//
// ```novo
// use gqlerr
// use gqlhttp
//
// fn main() [io]
//     println(gqlerr.code_of(gqlhttp.persisted_not_found()))
// ```
pub fn persisted_not_found() -> gqlerr.GqlError []
    gqlerr.error_with_code("PersistedQueryNotFound", "PERSISTED_QUERY_NOT_FOUND")
